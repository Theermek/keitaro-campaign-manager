# Keitaro Admin API base URL, including /admin_api/v1
KEITARO_API_URL=https://your-tracker.example/admin_api/v1
# Profile -> API keys in the Keitaro admin
KEITARO_API_KEY=
# Optional, seconds
KEITARO_TIMEOUT=15

# Only campaigns with this prefix may be created or changed
CAMPAIGN_PREFIX=test_lastname_

# Settings for new campaigns, by name (IDs are resolved via the API)
KEITARO_DOMAIN=example.com
KEITARO_GROUP=FORTESTS
KEITARO_SOURCE=FORTESTS

DATABASE_URL=sqlite:///./app.db
